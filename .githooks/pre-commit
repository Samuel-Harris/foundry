#!/usr/bin/env bash
# Refuse a commit that leaves markdown unlinted or a package lockfile stale.
#
# Markdown: markdownlint-cli2 0.14.0, the version the previous CI action pinned,
# over README.md, CHANGELOG.md, AGENTS.md and markdown under packages/, docs/
# and tests/. Config is .markdownlint.json and .markdownlint-cli2.jsonc.
#
# Lockfile: `apm install --frozen` rewrites a stale apm.lock.yaml and still
# exits 0. The staleness signal is that rewrite, ignoring the absolute checkout
# paths APM records for transitive siblings. The script installs every affected
# package, plus every package that depends on one.
#
# Locally it reads the staged diff. CI sets FOUNDRY_DIFF_RANGE (a git range
# such as origin/main...HEAD) or FOUNDRY_CHECK_ALL=1 and runs this same script.
#
# The lockfile half needs apm-cli 0.32.0. Prefer .venv-apm/bin/apm. Bypass that
# half with FOUNDRY_SKIP_LOCKFILE_HOOK=1. Markdown lint still runs.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

pinned_version="0.32.0"
markdownlint_version="${MARKDOWNLINT_CLI2_VERSION:-0.14.0}"
targets="${APM_TARGETS:-cursor,claude,copilot}"
apm_timeout="${APM_TIMEOUT:-300}"

bounded() {
  if command -v timeout >/dev/null 2>&1; then
    timeout "$apm_timeout" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$apm_timeout" "$@"
  elif command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$apm_timeout" "$@"
  else
    echo "pre-commit: no timeout mechanism available (need timeout, gtimeout or perl)" >&2
    return 127
  fi
}

has_pkg() {
  case " $1 " in
    *" $2 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# Same paths the former markdownlint CI job covered.
is_linted_markdown() {
  case "$1" in
    *.md) ;;
    *) return 1 ;;
  esac
  case "$1" in
    README.md|CHANGELOG.md|AGENTS.md|packages/*|docs/*|tests/*) return 0 ;;
  esac
  return 1
}

run_markdownlint() {
  echo "pre-commit: markdownlint-cli2 ${markdownlint_version}" >&2
  if [[ -x "$repo_root/node_modules/.bin/markdownlint-cli2" ]]; then
    bounded "$repo_root/node_modules/.bin/markdownlint-cli2" "$@"
  elif command -v npx >/dev/null 2>&1; then
    bounded npx --yes "markdownlint-cli2@${markdownlint_version}" "$@"
  else
    echo "pre-commit: markdownlint-cli2 not found (install Node.js so npx is on PATH)" >&2
    return 1
  fi
}

if [[ "${FOUNDRY_CHECK_ALL:-}" == "1" ]]; then
  changed_paths=""
elif [[ -n "${FOUNDRY_DIFF_RANGE:-}" ]]; then
  changed_paths="$(git diff --name-only --diff-filter=ACMRD "$FOUNDRY_DIFF_RANGE")"
else
  changed_paths="$(git diff --cached --name-only --diff-filter=ACMRD)"
fi

lint_status=0
if [[ "${FOUNDRY_CHECK_ALL:-}" == "1" ]]; then
  run_markdownlint \
    "packages/**/*.md" \
    "docs/**/*.md" \
    "tests/**/*.md" \
    "README.md" \
    "CHANGELOG.md" \
    "AGENTS.md" || lint_status=$?
else
  md_files=()
  while IFS= read -r path; do
    [[ -n "$path" && -f "$path" ]] || continue
    is_linted_markdown "$path" || continue
    md_files+=("$path")
  done <<< "$changed_paths"
  if [[ ${#md_files[@]} -gt 0 ]]; then
    run_markdownlint "${md_files[@]}" || lint_status=$?
  fi
fi

if [[ "${FOUNDRY_SKIP_LOCKFILE_HOOK:-}" == "1" ]]; then
  echo "pre-commit: skipping lockfile check (FOUNDRY_SKIP_LOCKFILE_HOOK=1)" >&2
  exit "$lint_status"
fi

if [[ -n "${APM:-}" ]]; then
  apm="$APM"
elif [[ -x "$repo_root/.venv-apm/bin/apm" ]]; then
  apm="$repo_root/.venv-apm/bin/apm"
else
  apm="$(command -v apm || true)"
fi

# Packages whose manifest, primitives or lockfile can change hashes.
seeds=""
if [[ "${FOUNDRY_CHECK_ALL:-}" == "1" ]]; then
  for manifest in "$repo_root"/packages/*/apm.yml; do
    pkg="$(basename "$(dirname "$manifest")")"
    seeds="$seeds $pkg"
  done
else
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    case "$path" in
      packages/*/apm.yml|packages/*/.apm/*|packages/*/apm.lock.yaml) ;;
      *) continue ;;
    esac
    pkg="${path#packages/}"
    pkg="${pkg%%/*}"
    if ! has_pkg "$seeds" "$pkg"; then
      seeds="$seeds $pkg"
    fi
  done <<< "$changed_paths"
fi

if [[ -z "${seeds# }" ]]; then
  if [[ -n "${FOUNDRY_DIFF_RANGE:-}${FOUNDRY_CHECK_ALL:-}" ]]; then
    echo "pre-commit: no package manifest, primitive or lockfile changes to check" >&2
  fi
  exit "$lint_status"
fi

if [[ -z "$apm" || ! -x "$apm" ]]; then
  echo "pre-commit: apm ${pinned_version} not found (set APM=, create .venv-apm, or put apm on PATH)" >&2
  exit 1
fi

version_line="$("$apm" --version 2>&1 || true)"
case "$version_line" in
  *"version ${pinned_version}"*) ;;
  *)
    echo "pre-commit: need apm ${pinned_version}, got: ${version_line:-<no version>}" >&2
    echo "pre-commit: python -m pip install \"apm-cli==${pinned_version}\"  (or use .venv-apm/bin/apm)" >&2
    exit 1
    ;;
esac

# Direct dependents, from sibling `path:` dependencies.
dependents_of() {
  local name="$1" manifest dep
  for manifest in "$repo_root"/packages/*/apm.yml; do
    dep="$(basename "$(dirname "$manifest")")"
    if grep -Eq "^[[:space:]]*-[[:space:]]*path:[[:space:]]*\\.\\./${name}[[:space:]]*$" "$manifest"; then
      printf '%s\n' "$dep"
    fi
  done
}

affected="$seeds"
queue="$seeds"
while [[ -n "${queue# }" ]]; do
  next=""
  for pkg in $queue; do
    while IFS= read -r dep; do
      [[ -n "$dep" ]] || continue
      if ! has_pkg "$affected" "$dep"; then
        affected="$affected $dep"
        next="$next $dep"
      fi
    done < <(dependents_of "$pkg")
  done
  queue="$next"
done

blockers=0
for pkg in $affected; do
  if [[ ! -f "packages/$pkg/apm.yml" ]]; then
    echo "pre-commit: packages/$pkg/apm.yml is missing; stage the removal or restore the package" >&2
    blockers=$((blockers + 1))
    continue
  fi
  dirty="$(
    git diff --name-only -- "packages/$pkg/apm.yml" "packages/$pkg/.apm" "packages/$pkg/apm.lock.yaml"
    git ls-files --others --exclude-standard -- "packages/$pkg/apm.yml" "packages/$pkg/.apm"
  )"
  if [[ -n "$dirty" ]]; then
    echo "pre-commit: packages/$pkg has unstaged source or lockfile changes; stage or stash them before committing:" >&2
    printf '  %s\n' $dirty >&2
    blockers=$((blockers + 1))
  fi
done
if (( blockers > 0 )); then
  exit 1
fi

stale=""
for pkg in $affected; do
  echo "pre-commit: apm install --frozen in packages/$pkg" >&2
  if ! ( cd "packages/$pkg" && bounded "$apm" install --frozen --target "$targets" ); then
    echo "pre-commit: apm install --frozen failed in packages/$pkg" >&2
    exit 1
  fi
  lock="packages/$pkg/apm.lock.yaml"
  if git diff --quiet -I 'anchored_local_path: /' -I 'local:/' -- "$lock"; then
    # Absolute checkout paths differ per machine. Drop that churn so a current
    # lockfile is not rewritten into the commit.
    if ! git diff --quiet -- "$lock"; then
      git checkout -- "$lock"
    fi
  else
    echo "pre-commit: lockfile diff for packages/$pkg:" >&2
    git diff -I 'anchored_local_path: /' -I 'local:/' -- "$lock" >&2 || true
    stale="$stale $pkg"
  fi
done

if [[ -n "${stale# }" ]]; then
  echo "pre-commit: apm.lock.yaml is stale for:${stale}" >&2
  echo "pre-commit: install rewrote those files. Review the diff and stage them:" >&2
  for pkg in $stale; do
    echo "  git add packages/$pkg/apm.lock.yaml" >&2
  done
  exit 1
fi

exit "$lint_status"
