# VS Code settings
.vscode/
.DS_Store

# APM working directories
apm_modules/

# Lockfile of the root development manifest. It records every package's version
# and file hashes, so it would go stale on any package change; the per-package
# lockfiles are the committed contract.
/apm.lock.yaml

# Local APM toolchain
.venv-apm/

# Build output
dist/
build/

# Node dependencies for the pstack script tests
node_modules/

# Python bytecode
__pycache__/
*.pyc

# Local environment
.env
.env.*
!.env.example

# Per-target deploy output (generated by `apm install`, never committed)
**/.cursor/rules/
**/.cursor/agents/
**/.cursor/commands/
**/.cursor/hooks.json
**/.cursor/mcp.json
**/.claude/
**/.codex/
**/.agents/
**/.github/agents/
**/.github/instructions/
**/.github/prompts/
**/.github/hooks/
**/.github/copilot-instructions.md
**/.github/plugin/
**/.claude-plugin/

# uv workspace virtual environment
.venv/

# Local Python toolchain for the data-visualisation build tools
.venv-viz/

# Data-visualisation build scratch (one-off scripts, smoke-test transcripts)
packages/data-visualisation/scratch/
