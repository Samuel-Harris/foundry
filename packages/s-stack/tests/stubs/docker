#!/usr/bin/env python3
"""Lists the containers in $STUB_DOCKER_CONTAINERS, one `<project>\t<working dir>` per line, and records every other call."""
import os, sys

args = sys.argv[1:]
if args[:1] == ["info"]:
    sys.exit(0)
if args[:2] == ["ps", "-a"]:
    with open(os.environ["STUB_DOCKER_CONTAINERS"]) as containers:
        sys.stdout.write(containers.read())
    sys.exit(0)
with open(os.environ["STUB_DOCKER_LOG"], "a") as log:
    log.write(" ".join(args) + "\n")
