#!/usr/bin/env python3
import os, subprocess, sys

# Like workmux, act on the repository the command runs in: its main checkout keeps the worktrees beside it.
common = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"], capture_output=True, text=True)
root = os.path.dirname(common.stdout.strip()) if common.returncode == 0 else os.environ["STUB_ROOT"]
with open(os.environ["STUB_WORKMUX_LOG"], "a") as log:
    log.write(" ".join(sys.argv[1:]) + "\n")

command, name, *rest = sys.argv[1:]
path = f"{root}__wt/{name}"
if command == "add":
    base = rest[rest.index("--base") + 1]
    subprocess.run(["git", "-C", root, "worktree", "add", "-q", "-b", name, path, base], check=True)
    if "--headless" not in rest:
        start = path
        if "STUB_WORKMUX_START_DIR" in os.environ:
            start = os.path.join(path, os.environ["STUB_WORKMUX_START_DIR"])
            os.makedirs(start)
        window = subprocess.run(["tmux", "new-window", "-d", "-P", "-F", "#{window_id}", "-c", start], check=True, capture_output=True, text=True).stdout.strip()
        subprocess.run(["tmux", "split-window", "-d", "-t", window, "-c", start], check=True)
elif command == "path":
    if not os.path.isdir(path):
        sys.exit(f"Worktree '{name}' not found")
    print(path)
